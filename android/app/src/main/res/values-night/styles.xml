<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LaunchTheme: applied to the Android Window while the process is starting
         when the OS Dark Mode setting is on. Same dark background as the light
         variant — Mileage is dark-first so both modes show the same splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show the Mileage splash screen. Automatically removed when
             the Flutter engine draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- NormalTheme: applied after Flutter initializes. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
