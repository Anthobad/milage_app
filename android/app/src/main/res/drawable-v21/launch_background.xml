<?xml version="1.0" encoding="utf-8"?>
<!-- Mileage launch/splash screen (API 21+): dark background with centered Mileage icon.
     This is the native Android launch background displayed before Flutter initializes.
     drawable-v21 is used on Android 5.0+ and supports vector drawables / ripples.
     Uses @mipmap/launch_image so the correct density variant is selected automatically. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark background — matches Mileage's default dark theme -->
    <item android:drawable="@color/launch_background_color" />

    <!-- Mileage icon centered on the screen -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item>
</layer-list>
